[Unit]
Description=llama.cpp embedding server for localRAG
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/localrag-embedding
ExecStart=/bin/bash -c 'exec "$LLAMA_CPP_BIN" -m "$LLAMA_MODEL_PATH" --host "$LLAMA_HOST" --port "$LLAMA_PORT" --embedding -ngl "$LLAMA_NGL"'
Restart=on-failure
RestartSec=5
User=localrag

[Install]
WantedBy=multi-user.target
