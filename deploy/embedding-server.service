[Unit]
Description=llama.cpp embedding server for localRAG
After=network.target

[Service]
Type=simple
User=${SERVICE_USER}

ExecStart=/bin/bash -c 'exec ${LLAMA_CPP_BIN} -m ${LLAMA_EMBED_PATH} --host ${LLAMA_HOST} --port ${LLAMA_EMBED_PORT} --embedding'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
